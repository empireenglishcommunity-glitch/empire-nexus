  "speaking_missions": {
    "Saturday": {"type": "reported_questions", "prompt": "Report three questions someone asked you ('He asked whether/where/why...').", "target_seconds": 45},
    "Sunday": {"type": "commands_requests", "prompt": "Report three orders/requests ('She told me to...', 'They asked me to...').", "target_seconds": 45},
    "Monday": {"type": "reporting_verbs", "prompt": "Use advise / warn / offer / suggest / admit to report what people said.", "target_seconds": 50},
    "Tuesday": {"type": "interview", "prompt": "Report the key exchanges from an interview you watched or imagined.", "target_seconds": 50},
    "Wednesday": {"type": "news", "prompt": "Report a news story using reporting verbs (claimed, confirmed, denied).", "target_seconds": 50},
    "Thursday": {"type": "conversation", "prompt": "Report a real conversation to a partner, then they report one back.", "target_seconds": 50},
    "Friday": {"type": "review", "prompt": "Report an interview or discussion in detail (10 sentences) with varied reporting verbs.", "target_seconds": 70}
  },
  "writing_prompts": [
    "Report three questions someone asked you.",
    "Report three commands/requests (told/asked me to...).",
    "Use five reporting verbs (advise/warn/offer/suggest/admit) to report speech.",
    "Report the key points of an interview.",
    "Report a news story using claimed/confirmed/denied.",
    "Rewrite a short dialogue entirely in reported speech.",
    "Write a paragraph summarising an interview with varied reporting verbs."
