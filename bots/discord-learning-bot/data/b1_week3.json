  "speaking_missions": {
    "Saturday": {
      "type": "arrangements",
      "prompt": "Say three fixed arrangements you have (present continuous): 'I'm meeting... on...'",
      "target_seconds": 40
    },
    "Sunday": {
      "type": "intentions",
      "prompt": "Talk about your plans/intentions with 'going to' (5 sentences).",
      "target_seconds": 45
    },
    "Monday": {
      "type": "predictions",
      "prompt": "Make predictions about next year with 'will' + probably/definitely.",
      "target_seconds": 45
    },
    "Tuesday": {
      "type": "contrast",
      "prompt": "Use all three: a plan (going to), an arrangement (continuous), a prediction (will).",
      "target_seconds": 50
    },
    "Wednesday": {
      "type": "arrange",
      "prompt": "Arrange to meet a friend: suggest, confirm, and react to a change.",
      "target_seconds": 45
    },
    "Thursday": {
      "type": "travel_roleplay",
      "prompt": "Roleplay a travel problem: you have missed your train and your hotel booking starts tonight. Speak to the ticket office, then to the hotel, using future forms ('I'll take the later train', \"I'm going to arrive after midnight\"). Ask for what you need and react to what you are told.",
      "target_seconds": 50
    },
    "Friday": {
      "type": "review",
      "prompt": "Describe your plans for the next month (8 sentences) using all future forms.",
      "target_seconds": 60
    }
  },
  "writing_prompts": [
