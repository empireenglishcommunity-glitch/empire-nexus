  "speaking_missions": {
    "Saturday": {"type": "present_perfect", "prompt": "Say three recent changes in your life: 'I have started/moved/learned...'", "target_seconds": 40},
    "Sunday": {"type": "contrast", "prompt": "Contrast: 'I have lived here for... I moved here in...' (present perfect vs past simple).", "target_seconds": 45},
    "Monday": {"type": "news", "prompt": "Share your recent news using just/already/yet in five sentences.", "target_seconds": 45},
    "Tuesday": {"type": "for_since", "prompt": "Talk about how long: 'I have ... for ...' and 'I have ... since ...'", "target_seconds": 40},
